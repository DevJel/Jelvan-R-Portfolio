    "react-scroll": "^1.9.0",
    "styled-components": "^5.3.11",
    "yup": "^0.32.11",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "20.14.12",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/react-scroll": "^1.8.10",
    "@types/styled-components": "^5.1.34",
