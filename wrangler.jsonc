{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Worker name = the project name shown in the Cloudflare dashboard
  // and the default URL: https://jelvan-r-portfolio.<your-subdomain>.workers.dev
  "name": "jelvan-r-portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",

  // The static site produced by `next build` (output: 'export').
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Only API routes run the Worker code; every page/image is served directly.
    "run_worker_first": ["/api/*"]
  },

  "observability": {
    "enabled": true
  },

  // Contact form: every submission is forwarded to this inbox.
  "vars": {
    "CONTACT_TO": "hello@work.jelvan.pro",
    "CONTACT_FROM": "portfolio@work.jelvan.pro"
  },

  // Cloudflare Email Service binding used by worker/index.ts to send:
  // the inbox forward and the submitter confirmation. No destination
  // allowlist, because confirmations go to whoever submitted the form.
  // The sender is locked to the portfolio address. The domain must be
  // onboarded in Cloudflare → Email Service.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["portfolio@work.jelvan.pro"]
    }
  ]
}
