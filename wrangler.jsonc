{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jelvan-portfolio-contact",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-15",
  "workers_dev": false,

  "routes": [
    {
      "pattern": "portfolio.jelvan.pro/api/contact*",
      "zone_name": "jelvan.pro"
    },
    {
      "pattern": "portfolio.jelvan.pro/api/repos*",
      "zone_name": "jelvan.pro"
    }
  ],

  "observability": {
    "enabled": true
  },

  "vars": {
    "CONTACT_TO": "hello@work.jelvan.pro"
  },

  "services": [
    {
      "binding": "MAILER",
      "service": "jelvan-portfolio-mailer"
    }
  ]
}
