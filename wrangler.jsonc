{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Worker name = the project name shown in the Cloudflare dashboard
  // and the default URL: https://jelvan-r-portfolio.<your-subdomain>.workers.dev
  "name": "jelvan-r-portfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",

  // The static site produced by `next build` (output: 'export').
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Only API routes run the Worker code; every page/image is served directly.
    "run_worker_first": ["/api/*"]
  },

  "observability": {
    "enabled": true
  },

  // Contact form settings (see README → "Contact form").
  "vars": {
    "CONTACT_TO": "",
    "CONTACT_FROM": ""
  },

  // Uncomment after onboarding your domain in Cloudflare → Email Service,
  // then fill CONTACT_TO / CONTACT_FROM above:
  // "send_email": [
  //   {
  //     "name": "EMAIL",
  //     "allowed_destination_addresses": ["you@example.com"]
  //   }
  // ],
}
